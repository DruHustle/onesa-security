# Local development only. Do not use this configuration in public networks.
DATABASE_URL=postgresql+psycopg://onesa_api:from-secret-manager@db:5432/onesa_security
OIDC_ISSUER=https://auth.onesa.eu/
OIDC_AUDIENCE=https://security-api.onesa.eu
# Prod: do not change. Collectors require independently verified mutual TLS.
COLLECTOR_REQUIRE_MTLS=true
# Optional approved provider, fixed URL only; never accept a URL from the API caller.
AI_UPSTREAM_URL=
AI_UPSTREAM_ALLOWED_HOSTS=
AI_UPSTREAM_API_KEY=
AI_UPSTREAM_MODEL=
# Browser application: dedicated confidential Auth0 client and registered API audience.
AUTH0_DOMAIN=auth.onesa.eu
AUTH0_CLIENT_ID=
AUTH0_CLIENT_SECRET=
AUTH0_SECRET=
APP_BASE_URL=http://localhost:3000
ONESA_API_ORIGIN=http://api:8080
ONESA_ORGANIZATION_ID=
