  "components": {
    "schemas": {
      "AlertChange": {
        "properties": {
          "status": {
            "type": "string",
            "enum": [
              "open",
              "investigating",
              "closed"
            ],
            "title": "Status"
          },
          "assigned_to": {
            "anyOf": [
              {
                "type": "string",
                "maxLength": 255
              },
              {
                "type": "null"
              }
            ],
            "title": "Assigned To"
          },
          "disposition": {
            "anyOf": [
              {
                "type": "string",
                "maxLength": 300
              },
              {
                "type": "null"
              }
            ],
            "title": "Disposition"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "status"
        ],
        "title": "AlertChange"
      },
      "AssetInput": {
        "properties": {
          "external_ref": {
            "type": "string",
            "maxLength": 150,
            "minLength": 4,
            "pattern": "^[A-Za-z0-9_.:-]+$",
            "title": "External Ref"
          },
          "category": {
            "type": "string",
            "enum": [
              "endpoint",
              "server",
              "application",
              "cloud"
            ],
            "title": "Category"
          },
          "label": {
            "type": "string",
            "maxLength": 150,
            "minLength": 1,
            "title": "Label"
          },
          "os_family": {
            "anyOf": [
              {
                "type": "string",
                "enum": [
                  "linux",
                  "windows",
                  "macos",
                  "other"
                ]
              },
              {
                "type": "null"
              }
            ],
            "title": "Os Family"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "external_ref",
          "category",
          "label"
        ],
        "title": "AssetInput"
      },
      "ChatMessage": {
        "properties": {
          "role": {
            "type": "string",
            "enum": [
              "user",
              "assistant",
              "system"
            ],
            "title": "Role"
          },
          "content": {
            "type": "string",
            "maxLength": 20000,
            "minLength": 1,
            "title": "Content"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "role",
          "content"
        ],
        "title": "ChatMessage"
      },
      "ChatRequest": {
        "properties": {
          "messages": {
            "items": {
              "$ref": "#/components/schemas/ChatMessage"
            },
            "type": "array",
            "maxItems": 30,
            "minItems": 1,
            "title": "Messages"
          },
          "stream": {
            "type": "boolean",
            "title": "Stream",
            "default": false
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "messages"
        ],
        "title": "ChatRequest"
      },
      "CollectorRegistration": {
        "properties": {
          "name": {
            "type": "string",
            "maxLength": 150,
            "minLength": 3,
            "title": "Name"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "name"
        ],
        "title": "CollectorRegistration"
      },
      "EventInput": {
        "properties": {
          "external_id": {
            "type": "string",
            "maxLength": 120,
            "minLength": 8,
            "pattern": "^[A-Za-z0-9_.:-]+$",
            "title": "External Id"
          },
          "event_type": {
            "type": "string",
            "enum": [
              "auth.failure",
              "auth.success",
              "iam.privilege_change",
              "endpoint.persistence",
              "host.posture"
            ],
            "title": "Event Type"
          },
          "subject_ref": {
            "type": "string",
            "maxLength": 120,
            "minLength": 3,
            "pattern": "^[A-Za-z0-9_.:-]+$",
            "title": "Subject Ref"
          },
          "asset_ref": {
            "anyOf": [
              {
                "type": "string",
                "maxLength": 150,
                "pattern": "^[A-Za-z0-9_.:-]+$"
              },
              {
                "type": "null"
              }
            ],
            "title": "Asset Ref"
          },
          "occurred_at": {
            "type": "string",
            "format": "date-time",
            "title": "Occurred At"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "external_id",
          "event_type",
          "subject_ref",
          "occurred_at"
