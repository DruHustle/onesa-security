  "components": {
    "schemas": {
      "AlertChange": {
        "properties": {
          "status": {
            "type": "string",
            "enum": [
              "open",
              "investigating",
              "closed"
            ],
            "title": "Status"
          },
          "assigned_to": {
            "anyOf": [
              {
                "type": "string",
                "maxLength": 255
              },
              {
                "type": "null"
              }
            ],
            "title": "Assigned To"
          },
          "disposition": {
            "anyOf": [
              {
                "type": "string",
                "maxLength": 300
              },
              {
                "type": "null"
              }
            ],
            "title": "Disposition"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "status"
        ],
        "title": "AlertChange"
      },
      "AssetInput": {
        "properties": {
          "external_ref": {
            "type": "string",
            "maxLength": 150,
            "minLength": 4,
            "pattern": "^[A-Za-z0-9_.:-]+$",
            "title": "External Ref"
          },
          "category": {
            "type": "string",
            "enum": [
              "endpoint",
              "server",
              "application",
              "cloud"
            ],
            "title": "Category"
          },
          "label": {
            "type": "string",
            "maxLength": 150,
            "minLength": 1,
            "title": "Label"
          },
          "os_family": {
            "anyOf": [
              {
                "type": "string",
                "enum": [
                  "linux",
                  "windows",
                  "macos",
                  "other"
                ]
              },
              {
                "type": "null"
              }
            ],
            "title": "Os Family"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "external_ref",
          "category",
          "label"
        ],
        "title": "AssetInput"
      },
      "ChatMessage": {
        "properties": {
          "role": {
            "type": "string",
            "enum": [
              "user",
              "assistant"
            ],
            "title": "Role"
          },
          "content": {
            "type": "string",
            "maxLength": 20000,
            "minLength": 1,
            "title": "Content"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "role",
          "content"
        ],
        "title": "ChatMessage"
      },
      "ChatRequest": {
        "properties": {
          "messages": {
            "items": {
              "$ref": "#/components/schemas/ChatMessage"
            },
            "type": "array",
            "maxItems": 30,
            "minItems": 1,
            "title": "Messages"
          },
          "stream": {
            "type": "boolean",
            "title": "Stream",
            "default": false
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "messages"
        ],
        "title": "ChatRequest"
      },
      "CollectorRegistration": {
        "properties": {
          "name": {
            "type": "string",
            "maxLength": 150,
            "minLength": 3,
            "title": "Name"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "name"
        ],
        "title": "CollectorRegistration"
      },
      "EventInput": {
        "properties": {
          "external_id": {
            "type": "string",
            "maxLength": 120,
            "minLength": 8,
            "pattern": "^[A-Za-z0-9_.:-]+$",
            "title": "External Id"
          },
          "event_type": {
            "type": "string",
            "enum": [
              "auth.failure",
              "auth.success",
              "iam.privilege_change",
              "endpoint.persistence",
              "host.posture"
            ],
            "title": "Event Type"
          },
          "subject_ref": {
            "type": "string",
            "maxLength": 120,
            "minLength": 3,
            "pattern": "^[A-Za-z0-9_.:-]+$",
            "title": "Subject Ref"
          },
          "asset_ref": {
            "anyOf": [
              {
                "type": "string",
                "maxLength": 150,
                "pattern": "^[A-Za-z0-9_.:-]+$"
              },
              {
                "type": "null"
              }
            ],
            "title": "Asset Ref"
          },
          "occurred_at": {
            "type": "string",
            "format": "date-time",
            "title": "Occurred At"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "external_id",
          "event_type",
          "subject_ref",
          "occurred_at"
        ],
        "title": "EventInput"
      },
      "FindingInput": {
        "properties": {
          "external_id": {
            "type": "string",
            "maxLength": 120,
            "minLength": 8,
            "pattern": "^[A-Za-z0-9_.:-]+$",
            "title": "External Id"
          },
          "asset_ref": {
            "type": "string",
            "maxLength": 150,
            "minLength": 4,
            "pattern": "^[A-Za-z0-9_.:-]+$",
            "title": "Asset Ref"
          },
          "title": {
            "type": "string",
            "maxLength": 150,
            "minLength": 5,
            "title": "Title"
          },
          "category": {
            "type": "string",
            "enum": [
              "configuration",
              "software",
              "exposure",
              "identity"
            ],
            "title": "Category"
          },
          "severity": {
            "type": "string",
            "enum": [
              "low",
              "medium",
              "high",
              "critical"
            ],
            "title": "Severity"
          },
          "cve_id": {
            "anyOf": [
              {
                "type": "string",
                "maxLength": 24,
                "pattern": "^CVE-[0-9]{4}-[0-9]{4,10}$"
              },
              {
                "type": "null"
              }
            ],
            "title": "Cve Id"
          },
          "evidence_ref": {
            "type": "string",
            "maxLength": 120,
            "minLength": 8,
            "pattern": "^[A-Za-z0-9_.:-]+$",
            "title": "Evidence Ref"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "external_id",
          "asset_ref",
          "title",
          "category",
          "severity",
          "evidence_ref"
        ],
        "title": "FindingInput"
      },
      "FindingResolution": {
        "properties": {
          "verification": {
            "type": "string",
            "enum": [
              "verified_resolved",
              "false_positive",
              "accepted_risk"
            ],
            "title": "Verification"
          },
          "evidence_ref": {
            "type": "string",
            "maxLength": 120,
            "minLength": 8,
            "pattern": "^[A-Za-z0-9_.:-]+$",
            "title": "Evidence Ref"
          },
          "note": {
            "type": "string",
            "maxLength": 300,
            "minLength": 15,
            "title": "Note"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "verification",
          "evidence_ref",
          "note"
        ],
        "title": "FindingResolution"
      },
      "HTTPValidationError": {
        "properties": {
          "detail": {
            "items": {
              "$ref": "#/components/schemas/ValidationError"
            },
            "type": "array",
            "title": "Detail"
          }
        },
        "type": "object",
        "title": "HTTPValidationError"
      },
      "InspectRequest": {
        "properties": {
          "text": {
            "type": "string",
            "maxLength": 20000,
            "minLength": 1,
            "title": "Text"
          },
          "action_type": {
            "type": "string",
            "enum": [
              "message",
              "tool"
            ],
            "title": "Action Type",
            "default": "message"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "text"
        ],
        "title": "InspectRequest"
      },
      "PolicyUpdate": {
        "properties": {
          "expected_version": {
            "type": "integer",
            "minimum": 0.0,
            "title": "Expected Version"
          },
          "block_injection": {
            "type": "boolean",
            "title": "Block Injection"
          },
          "redact_pii": {
            "type": "boolean",
            "title": "Redact Pii"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "expected_version",
          "block_injection",
          "redact_pii"
        ],
        "title": "PolicyUpdate"
      },
      "RemediationDecision": {
        "properties": {
          "decision": {
            "type": "string",
            "enum": [
              "approve",
              "reject"
            ],
            "title": "Decision"
          },
          "note": {
            "type": "string",
            "maxLength": 300,
            "minLength": 15,
            "title": "Note"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "decision",
          "note"
        ],
        "title": "RemediationDecision"
      },
      "RemediationRequest": {
        "properties": {
          "finding_id": {
            "type": "string",
            "pattern": "^[0-9a-f-]{36}$",
            "title": "Finding Id"
          },
          "action_type": {
            "type": "string",
            "enum": [
              "patch_plan",
              "configuration_hardening",
              "credential_rotation",
              "firewall_review"
            ],
            "title": "Action Type"
          },
          "action_summary": {
            "type": "string",
            "maxLength": 500,
            "minLength": 15,
            "title": "Action Summary"
          },
          "impact_summary": {
            "type": "string",
            "maxLength": 500,
            "minLength": 15,
            "title": "Impact Summary"
          },
          "rollback_plan": {
            "type": "string",
            "maxLength": 500,
            "minLength": 15,
            "title": "Rollback Plan"
          },
          "dry_run": {
            "type": "boolean",
            "const": true,
            "title": "Dry Run"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "finding_id",
          "action_type",
          "action_summary",
          "impact_summary",
          "rollback_plan",
          "dry_run"
        ],
        "title": "RemediationRequest"
      },
      "ValidationError": {
        "properties": {
          "loc": {
            "items": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "integer"
                }
              ]
            },
            "type": "array",
            "title": "Location"
          },
          "msg": {
            "type": "string",
            "title": "Message"
          },
          "type": {
            "type": "string",
            "title": "Error Type"
          },
          "input": {
            "title": "Input"
          },
          "ctx": {
            "type": "object",
            "title": "Context"
          }
        },
        "type": "object",
        "required": [
          "loc",
          "msg",
          "type"
        ],
        "title": "ValidationError"
      }
    }
  }
